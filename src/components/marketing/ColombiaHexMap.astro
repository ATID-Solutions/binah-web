<svg class:list={["co-map", className]} viewBox="10 3 309 444" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="co-map-glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#7a68ff" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#4d37f6" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <circle cx={HQ.x} cy={HQ.y} r="70" fill="url(#co-map-glow)"></circle>
  <path class="co-map-base" d={paths.base}></path>
  <path class="co-map-far" d={paths.far}></path>
  <path class="co-map-near" d={paths.near}></path>
  <path class="co-map-hq" d={paths.hq}></path>

  <g class="co-map-pin">
    <circle class="co-map-ping" cx={HQ.x} cy={HQ.y} r="9"></circle>
    <circle cx={HQ.x} cy={HQ.y} r="4.2" fill="#fff"></circle>
  </g>
  <!-- Callout to the upper left, over the Caribbean (La Guajira is to the right). -->
  <g class="co-map-callout">
    <path d={`M${HQ.x - 7} ${HQ.y - 6}l-20 -18h-22`}></path>
    <text x={HQ.x - 54} y={HQ.y - 26}>Barranquilla</text>
    <text class="co-map-sub" x={HQ.x - 54} y={HQ.y - 13}>Sede principal</text>
  </g>
</svg>

<style>
  .co-map {
    display: block;
    overflow: visible;
  }
  .co-map-base {
    fill: rgba(255, 255, 255, 0.13);
  }
  .co-map-far {
    fill: rgba(156, 143, 255, 0.26);
  }
  .co-map-near {
    fill: rgba(156, 143, 255, 0.52);
  }
  .co-map-hq {
    fill: #9c8fff;
  }
  .co-map-ping {
    fill: none;
    stroke: rgba(201, 194, 255, 0.85);
    stroke-width: 1.4;
    transform-box: fill-box;
    transform-origin: center;
    animation: co-map-ping 2.6s ease-out infinite;
  }
  .co-map-callout path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.35);
    stroke-width: 1;
  }
  .co-map-callout text {
    text-anchor: end;
    font-family: var(--font-sans, system-ui);
    font-size: 13px;
    font-weight: 600;
    fill: #fff;
  }
  .co-map-callout .co-map-sub {
    font-family: var(--font-mono, ui-monospace);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: rgba(245, 245, 241, 0.6);
  }

  @keyframes co-map-ping {
    0% {
      transform: scale(0.5);
      opacity: 1;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .co-map-ping {
      animation: none;
    }
  }
</style>
