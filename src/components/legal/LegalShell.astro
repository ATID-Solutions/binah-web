---
import Footer from "../binah/Footer.astro";
import Nav from "../binah/Nav.astro";
import Layout from "../../layouts/Layout.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  canonicalPath: string;
  alternatePath: string;
  version: string;
  locale: "es" | "en";
}

const { title, description, eyebrow, heading, canonicalPath, alternatePath, version, locale } = Astro.props;
const isEnglish = locale === "en";
const spanishPath = isEnglish ? alternatePath : canonicalPath;
const englishPath = isEnglish ? canonicalPath : alternatePath;
---

<Layout
  title={title}
  description={description}
  page="legal"
  canonicalPath={canonicalPath}
  ogType="article"
  enableMarketingTracking={false}
  showContactWidget={false}
  lang={locale}
  alternateLinks={[
    { hreflang: "es-CO", href: spanishPath },
    { hreflang: "en-US", href: englishPath },
    { hreflang: "x-default", href: spanishPath },
  ]}
>
  <Nav locale={locale} />
  <main class="legal-page">
    <header class="legal-header container-binah">
      <div class="eyebrow">{eyebrow}</div>
      <h1>{heading}</h1>
      <div class="legal-meta">
        <p>{isEnglish ? "Binah is operated by Soluciones ALCO S.A.S." : "Binah es operado por Soluciones ALCO S.A.S."}</p>
        <p class="mono">{isEnglish ? "Version" : "Versión"}: {version}</p>
        <p>{isEnglish ? "Effective date: pending owner confirmation" : "Fecha de entrada en vigor: pendiente de confirmación del titular"}</p>
      </div>
      <nav class="legal-language-nav" aria-label={isEnglish ? "Language" : "Idioma"}>
        <a href={spanishPath} lang="es" aria-current={!isEnglish ? "page" : undefined}>Español</a>
        <span aria-hidden="true">/</span>
        <a href={englishPath} lang="en" aria-current={isEnglish ? "page" : undefined}>English</a>
      </nav>
    </header>

    <div class="legal-document legal-document-single container-binah">
      <slot />
    </div>
  </main>
  <Footer locale={locale} />
</Layout>
