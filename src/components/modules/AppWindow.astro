---
// Browser-window frame for the module pages' product shots: the same chrome
// as the home hero's product mock (dots, address bar, team avatars) on a
// white window with a soft glow, and an "Ejemplo ilustrativo" caption. The
// window body is the default slot; each shot lays out its own body.
interface Props {
  /** Address shown in the bar, e.g. "app.binah.co/crm/inbox". */
  url: string;
  /** Text alternative for the whole illustration. */
  label: string;
  people?: string[];
}

const { url, label, people = ["AN", "JM", "+3"] } = Astro.props;
---

<figure class="aw" data-nav-light>
  <div class="aw-window" data-nosnippet role="img" aria-label={label}>
    <div class="aw-bar">
      <span class="aw-dots"><i></i><i></i><i></i></span>
      <span class="aw-url">{url}</span>
      <span class="aw-people">{people.map((p) => <i>{p}</i>)}</span>
    </div>
    <slot />
  </div>
  <figcaption>Ejemplo ilustrativo</figcaption>
</figure>

<style>
  .aw {
    position: relative;
    max-width: 1140px;
    margin: 0 auto;
  }
  .aw figcaption {
    margin-top: 14px;
    text-align: right;
    font-size: 12px;
    color: var(--hp-mute);
  }
  .aw-window {
    position: relative;
    border-radius: 18px;
    background: #fff;
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow:
      0 0 0 8px rgba(255, 255, 255, 0.06),
      0 2px 6px rgba(0, 0, 0, 0.12),
      0 40px 100px -30px rgba(10, 8, 40, 0.55);
    overflow: hidden;
    color: var(--hp-ink);
    font-size: 12.5px;
    text-align: left;
  }
  .aw-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 40px;
    padding: 0 14px;
    border-bottom: 1px solid #eeede8;
    background: #fbfbf9;
  }
  .aw-dots {
    display: flex;
    gap: 6px;
  }
  .aw-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #e3e2dc;
  }
  .aw-url {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--hp-mute);
    background: #f1f0eb;
    border-radius: 6px;
    padding: 4px 14px;
    white-space: nowrap;
  }
  .aw-people {
    display: flex;
    justify-content: flex-end;
  }
  .aw-people i {
    width: 24px;
    height: 24px;
    margin-left: -6px;
    border-radius: 50%;
    border: 2px solid #fbfbf9;
    display: grid;
    place-items: center;
    font-style: normal;
    font-size: 9px;
    font-weight: 600;
    color: #fff;
    background: var(--hp-purple);
  }
  .aw-people i:nth-child(2) {
    background: #1f7a5a;
  }
  .aw-people i:nth-child(3) {
    background: #e7e6e0;
    color: var(--hp-mute);
  }

  @media (max-width: 760px) {
    .aw-window {
      border-radius: 16px;
    }
    .aw-bar {
      grid-template-columns: auto 1fr;
      gap: 12px;
    }
    .aw-url {
      justify-self: start;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }
    .aw-people {
      display: none;
    }
  }
</style>
