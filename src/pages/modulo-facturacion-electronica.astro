      {
        icon: { icon: "documentMinus" },
        title: "Notas crédito y débito",
        body: "Ajustes por devoluciones, cambios o correcciones, asociados al pedido original y al cliente.",
      },
      {
        icon: { icon: "document" },
        title: "Documento soporte",
        body: "El documento soporte sale de tus flujos de compras, en el mismo lugar que tus facturas.",
      },
      {
        icon: { icon: "store" },
        title: "Documento equivalente POS",
        body: "Ventas de mostrador con un catálogo de códigos internos o EAN, conectadas al inventario.",
        link: { label: "POS electrónico", href: "/pos-documento-equivalente-electronico-dian" },
      },
      {
        icon: { icon: "signature" },
        title: "Firma digital incluida",
        body: "Cada documento se genera, se firma y se envía a la DIAN desde Binah.",
      },
      {
        icon: { icon: "chart" },
        title: "Reportes de facturación",
        body: "Por cliente, vendedor, canal y estado, sin esperar un cierre manual.",
