  demoMessage: WA_MESSAGES.moduleFacturacion,
  hero: {
    crumb: "Facturación",
    eyebrow: "Módulo 04 · Facturación electrónica",
    title: "Factura electrónica",
    accent: "desde cada venta.",
    lead: "Facturas, notas crédito y débito, documento soporte y documento equivalente POS emitidos a la DIAN con los datos de la operación. Firma digital incluida. Nadie vuelve a digitar lo que ya está en el pedido.",
  },
  features: {
    label: "Documentos DIAN",
    title: "Cada documento DIAN",
    soft: "nace de la operación.",
    lead: "Cliente, productos, impuestos, envío y medio de pago ya vienen de la venta. Facturación deja de ser una digitación posterior y cada documento queda ligado a lo que lo originó.",
