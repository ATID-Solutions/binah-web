        visual: {
          type: "rows",
          title: "Conciliación · hoy",
          rows: [
            { label: "FE-10293 · $289.900", value: "Pagada", tone: "green" },
            { label: "FE-10292 · $1.240.000", value: "Pagada", tone: "green" },
