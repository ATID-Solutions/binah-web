---
import Footer from "../components/binah/Footer.astro";
import Nav from "../components/binah/Nav.astro";
import Layout from "../layouts/Layout.astro";
import {
  SMS_CONSENT_TEXT_VERSION,
  SMS_PROGRAM_NAME,
  SMS_SUPPORT_EMAIL,
  SMS_SUPPORT_NUMBER,
  SMS_USE_CASE,
} from "../lib/smsProgram";
---

<Layout
  title="Programa de Marketing SMS / SMS Marketing Program — Binah"
  description="Inscripción opcional al programa de mensajes de marketing y novedades de producto de Binah, operado por Soluciones ALCO S.A.S."
  page="sms"
  canonicalPath="/sms"
  enableMarketingTracking={false}
  showContactWidget={false}
>
  <Nav />
  <main class="sms-page">
    <header class="sms-header container-binah">
      <div class="eyebrow">{SMS_PROGRAM_NAME}</div>
      <div class="sms-header-grid">
        <div>
          <h1>Actualizaciones de Binah, directo a tu teléfono.</h1>
          <p lang="en">Binah updates, sent directly to your phone.</p>
        </div>
        <div class="sms-program-summary">
          <p>
            Recibe noticias de producto, anuncios de funcionalidades, contenido educativo, invitaciones a demostraciones y ofertas especiales de Binah.
          </p>
          <p lang="en">
            Receive Binah product news, feature announcements, educational content, product-demo invitations, and special offers.
          </p>
          <dl>
            <div><dt>Operador / Operator</dt><dd>Soluciones ALCO S.A.S.</dd></div>
            <div><dt>Número / Number</dt><dd>{SMS_SUPPORT_NUMBER}</dd></div>
            <div><dt>Frecuencia / Frequency</dt><dd>Varía / Varies</dd></div>
          </dl>
        </div>
      </div>
    </header>

    <section class="sms-enrollment container-binah" aria-labelledby="sms-form-title">
      <div class="sms-enrollment-intro">
        <span class="mono">01 / Opt-in</span>
        <h2 id="sms-form-title">Inscríbete voluntariamente.<span lang="en">Opt in voluntarily.</span></h2>
        <p>
          Tu consentimiento para mensajes SMS es independiente, opcional y no es condición para comprar ni usar Binah.
        </p>
        <p lang="en">
          Your SMS consent is separate, optional, and is not a condition of purchasing or using Binah.
        </p>
      </div>

      <form
        class="sms-form"
        data-sms-form
        data-consent-version={SMS_CONSENT_TEXT_VERSION}
        novalidate
      >
        <div class="sms-form-field">
          <label for="sms-name">Nombre / Name <span>Opcional / Optional</span></label>
          <input id="sms-name" name="name" type="text" autocomplete="name" maxlength="100" />
        </div>

        <div class="sms-form-field">
          <label for="sms-phone">Número móvil de Estados Unidos / US mobile number</label>
          <input
            id="sms-phone"
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel-national"
            placeholder="+1 202 555 0147"
            aria-describedby="sms-phone-help sms-phone-error"
            required
          />
          <p id="sms-phone-help" class="sms-field-help">Incluye el código de área. / Include the area code.</p>
          <p id="sms-phone-error" class="sms-field-error" role="alert" hidden>
            Ingresa un número móvil válido de Estados Unidos. / Enter a valid US mobile number.
          </p>
        </div>

        <div class="sms-honeypot" aria-hidden="true">
          <label for="sms-website">Website</label>
          <input id="sms-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="sms-consent-row">
          <input
            id="sms-consent"
            name="consent"
            type="checkbox"
            aria-describedby="sms-consent-error"
          />
          <label for="sms-consent">
            I agree to receive recurring marketing and promotional text messages from Binah, operated by Soluciones ALCO S.A.S., at the number provided. Consent is not a condition of purchase. Message frequency varies. Message and data rates may apply. Reply STOP to opt out or HELP for help. See our <a href="/terminos">Terms</a> and <a href="/privacidad">Privacy Policy</a>.
          </label>
        </div>
        <p id="sms-consent-error" class="sms-field-error" role="alert" hidden>
          Debes marcar la casilla para dar tu consentimiento SMS. / Check the box to provide SMS consent.
        </p>

        <div class="sms-form-actions">
          <button type="submit" class="btn btn-primary" disabled data-submit>
            Inscribirme / Opt in <span class="arrow" aria-hidden="true">→</span>
          </button>
          <p>Podrás responder STOP en cualquier momento. / You can reply STOP at any time.</p>
        </div>

        <div class="sms-form-status" role="status" aria-live="polite" data-status></div>
      </form>

      <div class="sms-success" data-success hidden tabindex="-1">
        <span class="mono">Consentimiento registrado / Consent recorded</span>
        <h2>Gracias. Guardamos tu inscripción.</h2>
        <p>
          No enviaremos el mensaje de bienvenida hasta que el número gratuito haya sido verificado. Cuando los envíos estén habilitados, podrás responder STOP para retirarte o HELP para recibir ayuda.
        </p>
        <p lang="en">
          We will not send the welcome message until the toll-free number is verified. Once messaging is enabled, you can reply STOP to opt out or HELP for assistance.
        </p>
      </div>
    </section>

    <section class="sms-disclosure container-binah" aria-labelledby="sms-details-title">
      <div>
        <span class="mono">02 / Program details</span>
        <h2 id="sms-details-title">Cómo funciona el programa.<span lang="en">How the program works.</span></h2>
      </div>
      <div>
        <p lang="en">{SMS_USE_CASE}</p>
        <p>
          Este número se utiliza exclusivamente para la audiencia que se inscribe directamente con Binah. No es un número compartido para campañas enviadas por negocios clientes independientes. Binah no utiliza listas compradas ni listas de terceros.
        </p>
        <p>
          Ayuda / Help: <a href={`mailto:${SMS_SUPPORT_EMAIL}`}>{SMS_SUPPORT_EMAIL}</a>. Consulta los <a href="/terminos#sms-marketing-program">Términos del programa SMS</a> y la <a href="/privacidad#sms-privacy">Política de Privacidad</a>.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import { normalizeUsPhone } from "../lib/smsProgram";

  function initializeSmsForm() {
    const form = document.querySelector<HTMLFormElement>("[data-sms-form]");
    if (!form || form.dataset.ready === "true") return;
    form.dataset.ready = "true";

    const phone = form.elements.namedItem("phone") as HTMLInputElement;
    const name = form.elements.namedItem("name") as HTMLInputElement;
    const consent = form.elements.namedItem("consent") as HTMLInputElement;
    const website = form.elements.namedItem("website") as HTMLInputElement;
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    const status = form.querySelector<HTMLElement>("[data-status]");
    const phoneError = document.querySelector<HTMLElement>("#sms-phone-error");
    const consentError = document.querySelector<HTMLElement>("#sms-consent-error");
    const success = document.querySelector<HTMLElement>("[data-success]");
    const startedAt = Date.now();

    if (!phone || !name || !consent || !website || !submit || !status || !phoneError || !consentError || !success) {
      return;
    }

    const isPhoneValid = () => normalizeUsPhone(phone.value) !== null;

    const updateState = () => {
      const validPhone = isPhoneValid();
      submit.disabled = !(validPhone && consent.checked);
      phone.setAttribute("aria-invalid", String(phone.value.length > 0 && !validPhone));
      consent.setAttribute("aria-invalid", String(!consent.checked && consentError.hidden === false));

      if (validPhone) phoneError.hidden = true;
      if (consent.checked) consentError.hidden = true;
    };

    phone.addEventListener("input", updateState);
    consent.addEventListener("change", updateState);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      status.textContent = "";

      const validPhone = isPhoneValid();
      phoneError.hidden = validPhone;
      consentError.hidden = consent.checked;
      updateState();

      if (!validPhone) {
        phone.focus();
        return;
      }

      if (!consent.checked) {
        consent.focus();
        return;
      }

      submit.disabled = true;
      submit.setAttribute("aria-busy", "true");
      status.textContent = "Guardando consentimiento… / Recording consent…";

      try {
        const response = await fetch("/api/sms-consent", {
          method: "POST",
          headers: {
            accept: "application/json",
            "content-type": "application/json",
          },
          body: JSON.stringify({
            name: name.value,
            phone: phone.value,
            consent: consent.checked,
            consentTextVersion: form.dataset.consentVersion,
            formStartedAt: startedAt,
            website: website.value,
          }),
        });

        const result = await response.json();
        if (!response.ok || result.ok !== true) {
          if (result.error === "rate_limited") {
            throw new Error("rate_limited");
          }
          throw new Error("submission_failed");
        }

        form.hidden = true;
        success.hidden = false;
        success.focus();
      } catch (error) {
        status.textContent =
          error instanceof Error && error.message === "rate_limited"
            ? "Demasiados intentos. Espera unos minutos. / Too many attempts. Please wait a few minutes."
            : "No pudimos guardar tu consentimiento en este momento. Intenta de nuevo. / We could not record your consent right now. Please try again.";
        submit.removeAttribute("aria-busy");
        updateState();
      }
    });

    updateState();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeSmsForm, { once: true });
  } else {
    initializeSmsForm();
  }

  document.addEventListener("astro:page-load", initializeSmsForm);
</script>
