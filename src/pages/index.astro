---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/binah/Nav.astro";
import Footer from "../components/binah/Footer.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeIntro from "../components/home/HomeIntro.astro";
import HomeChallenge from "../components/home/HomeChallenge.astro";
import HomeModules from "../components/home/HomeModules.astro";
import HomeAI from "../components/home/HomeAI.astro";
import HomeInsights from "../components/home/HomeInsights.astro";
import HomeSolutions from "../components/home/HomeSolutions.astro";
import HomeIntegrations from "../components/home/HomeIntegrations.astro";
import HomeReviews from "../components/home/HomeReviews.astro";
import HomeCta from "../components/home/HomeCta.astro";
import { waUrl, WA_MESSAGES } from "../components/binah/whatsapp";
import "../styles/marketing.css";

const demoHref = waUrl(WA_MESSAGES.demo);
const chatFallbackHref = waUrl(WA_MESSAGES.general);
---

<Layout
  title="Binah — Software de gestión empresarial con IA en Colombia"
  description="CRM, ventas e inventario, facturación electrónica DIAN, contabilidad, pagos y despachos en una sola plataforma, con agentes de IA que venden y atienden."
  page="index"
  canonicalPath="/"
  navVariant="overlay"
>
  <Nav />

  <main class="hp">
    <HomeHero demoHref={demoHref} chatFallbackHref={chatFallbackHref} />
    <HomeIntro />
    <HomeChallenge />
    <HomeModules />
    <HomeAI />
    <HomeInsights />
    <HomeSolutions />
    <HomeIntegrations />
    <HomeReviews />
    <HomeCta demoHref={demoHref} />
  </main>

  <Footer />
</Layout>

<script>
  // Reveal-on-scroll. Elements are visible by default; only the ones that
  // start below the fold are hidden, then revealed as they scroll in.
  function initReveal() {
    const items = document.querySelectorAll<HTMLElement>(".hp-reveal:not([data-reveal])");
    if (!items.length) return;
    if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          (entry.target as HTMLElement).dataset.reveal = "done";
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -6% 0px", threshold: 0.06 },
    );

    const fold = window.innerHeight * 0.94;
    items.forEach((el) => {
      if (el.getBoundingClientRect().top > fold) {
        el.dataset.reveal = "pending";
        observer.observe(el);
      } else {
        el.dataset.reveal = "done";
      }
    });
  }

  document.addEventListener("astro:page-load", initReveal);
</script>
