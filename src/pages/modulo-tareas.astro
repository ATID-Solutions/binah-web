    steps: [
      {
        title: "Pasa algo en Binah",
        body: "Se cierra una venta, entra un pedido o se abre un caso de soporte.",
        modules: ["crm", "retail", "soporte"],
      },
      {
        title: "Se crea la tarea",
        body: "Con responsable, fecha, prioridad y el enlace al pedido, al cliente o al ticket.",
      },
      {
        title: "El equipo la mueve",
        body: "En el tablero, la lista o el cronograma, con los comentarios dentro de la tarea.",
      },
      {
        title: "Nadie pregunta qué falta",
        body: "Cada pendiente tiene dueño, estado y contexto, a la vista de todo el equipo.",
      },
    ],
  },
  solutions: {
    title: "Soluciones con tareas.",
    lead: "Casos concretos para equipos que organizan su trabajo desde Binah.",
  },
  faqs: [
    {
      q: "¿Qué vistas tiene el módulo de Tareas?",
      a: "Tableros Kanban, listas y cronograma (línea de tiempo). Son las mismas tareas vistas de tres formas, con responsable, fecha, prioridad y comentarios.",
    },
    {
      q: "¿Cómo se conectan las tareas con el resto de Binah?",
      a: "Las ventas, los pedidos y los casos de soporte se convierten en tareas visibles para cada equipo. Cada tarea queda enlazada al pedido, al cliente o al ticket que la originó.",
    },
    {
      q: "¿Se puede activar sin cambiar todo el negocio de una vez?",
      a: "Sí. Puedes empezar con un tablero para un equipo y conectar ventas, pedidos y soporte cuando la operación lo pida.",
    },
    {
      q: "¿El equipo de Binah ayuda con la configuración?",
      a: "Sí. Armamos contigo los tableros de cada equipo y te ayudamos a migrar los pendientes que hoy tienes en otras herramientas.",
    },
  ],
  cta: {
    eyebrow: "Tareas · Módulo 08",
    heading: "Que cada pendiente tenga dueño.",
    lead: "Armamos los tableros de cada equipo y conectamos las tareas con tus ventas, pedidos y casos de soporte. Tú solo revisas y apruebas.",
  },
};
---

<ModulePage content={content}>
  <TasksShot slot="shot" />
</ModulePage>
